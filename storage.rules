rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Profile Pictures: Users can read/write their own profile picture
    match /profile_pictures/{fileName} {
      allow read: if request.auth != null;
      // Allow upload (create/update) with size and type validation
      allow create, update: if request.auth != null 
                   && fileName.matches(request.auth.uid + '.*')
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      // Allow delete without resource checks (request.resource is null on delete)
      allow delete: if request.auth != null 
                   && fileName.matches(request.auth.uid + '.*');
    }
    
    // Posts: Users can read all posts, write their own
    match /posts/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
