rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - any authenticated user can read, only owner can write
    // Exception: followersCount and followingCount can be updated by any authenticated user
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount', 'unreadMessages']))
      );
      
      // Followers subcollection - the follower creates/deletes their own doc
      // The profile owner can also delete follower docs (for account deletion)
      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.auth.uid == followerId;
        allow delete: if request.auth != null
                      && (request.auth.uid == followerId
                          || request.auth.uid == userId);
      }
      
      // Following subcollection - the user manages their own following list
      match /following/{followedId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
                              && request.auth.uid == userId;
      }
      
      // Blocked Users subcollection - owner manages, anyone can check
      match /blockedUsers/{blockedUid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
                              && request.auth.uid == userId;
      }
    }
    
    // Usernames collection - for username uniqueness checks
    match /usernames/{username} {
      // Anyone can check if a username exists (for signup form validation)
      allow get: if true;
      
      // Only the owner (uid in doc must match auth uid) can create their username
      allow create: if request.auth != null 
                    && request.resource.data.uid == request.auth.uid;
      
      // Only the owner can delete their username
      allow delete: if request.auth != null 
                    && resource.data.uid == request.auth.uid;
      
      // No updates allowed - usernames are immutable
      allow update: if false;
    }
    
    // Posts collection
    match /posts/{postId} {
      // Any authenticated user can read posts
      allow read: if request.auth != null;
      
      // Only the owner can create their post
      allow create: if request.auth != null 
                    && request.resource.data.uid == request.auth.uid;
      
      // Only the owner can delete their post
      allow delete: if request.auth != null 
                    && resource.data.uid == request.auth.uid;
      
      // Allow likesCount and commentsCount updates from any authenticated user
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount']);
      
      // Likes subcollection - user deletes own like OR post owner can delete any
      match /likes/{likeUserId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.auth.uid == likeUserId;
        allow delete: if request.auth != null
                      && (request.auth.uid == likeUserId
                          || get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid);
      }
      
      // Comments subcollection - author deletes own OR post owner can delete any
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
                      && (resource.data.uid == request.auth.uid
                          || get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid);
      }
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if request.auth != null
                  && resource.data.recipientUid == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null
                    && resource.data.recipientUid == request.auth.uid;
      allow delete: if request.auth != null;
    }
    
    // Chats collection — only participants can access
    match /chats/{chatId} {
      allow read, update, delete: if request.auth != null
                                  && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;
      
      // Messages subcollection — participants read, sender creates/edits, participants delete
      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in
                       get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.senderUid;
        allow update: if request.auth != null
                      && request.auth.uid == resource.data.senderUid;
        allow delete: if request.auth != null
                      && (request.auth.uid == resource.data.senderUid
                          || request.auth.uid in
                             get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
      }
    }
    
    // Reports collection — any auth user can create, admin-only read
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.reporterUid;
      allow read: if false;
    }
  }
}